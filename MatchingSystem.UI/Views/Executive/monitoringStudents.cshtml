@{
    Layout = "~/Views/Shared/_GeneralLayout.cshtml";
    ViewData["active"] = "monitoring";
    ViewData["title"] = "Мониторинг: студенты";
}

<!DOCTYPE html>

<html lang="ru">
<head>
    <title>Мониторинг: Студеты</title> 
    <style>
        a.refused{
            color: gray;
        }
    </style>
</head>
<body>
<div id="app">
    <div id="app">
        <v-app>
            <v-container  style="max-width: 1200px">
                <h2 class="col col-12">Мониторинг распределния: Студенты</h2>
                <div v-if="students">

                    <div>
                        <v-card-title>
                            <v-spacer></v-spacer>
                            <v-spacer></v-spacer>
                            <v-spacer></v-spacer>
                            <v-text-field
                                v-model="tableSearch"
                                label="Поиск"
                                hide-details>
                            </v-text-field>
                        </v-card-title>
                    </div>
                    <v-data-table
                       
                        v-if="students"
                        :headers="headers"
                        :items="students"   
                        :items-per-page="2"
                        :search="tableSearch">
                        <template v-slot:item="{ item }">
                             <tr class="text-center">
                                <td>
                                    {{item.groupName}}
                                </td>

                                <td>
                                    {{item.nameAbbreviation}}
                                </td>

                                <td >
                                    <a v-on:click.prevent="viewProject(item.assignedProjectId)" class="btn" v-if="item.assignedProjectId">
                                        {{formatProjectName(item.assignedProjectId)}}
                                    </a>
                                    <span v-else>---</span>
                                </td>
                                <td>
                                    <div v-for="(projectId, index) in item.preferenceProjectIds">
                                        <a v-on:click.prevent="viewProject(projectId)" class="btn">
                                            {{index+1}}.{{formatProjectName(projectId)}} - {{formatProjectStatus(item,projectId)}}
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        </template>
                    </v-data-table>
                </div>

                <v-row align="center" justify="center" v-else style="min-height: 250px">
                    <v-progress-circular
                        indeterminate
                        size="200"
                        color="primary">
                    </v-progress-circular>
                </v-row>
            </v-container>
           <v-dialog
                    v-model="showProjectModal"
                    max-width="600">
                    <v-card tile v-if="projectToView">
                        <v-toolbar dark>
                            <v-toolbar-title>Проект</v-toolbar-title>
                        </v-toolbar>
                        <v-card-text>
                            <v-form>
                                <v-text-field
                                    :label="'Название'"
                                    v-model="projectToView.projectName"
                                    readonly>
                                </v-text-field>
                                
                                <v-text-field
                                    :label="'Преподаватель'"
                                    v-model="findTutorById(projectToView.tutorId).nameAbbreviation"
                                    readonly>
                                </v-text-field>
        
                                <v-text-field
                                    :label="'Описание'"
                                    v-model="projectToView.info"
                                    readonly>
                                </v-text-field>
        
                                <v-text-field
                                    v-if="projectToView.quota!=null"
                                    :label="'Квота'"
                                    v-model="projectToView.quota"
                                    readonly>
                                </v-text-field>
                                <v-text-field
                                    v-else
                                    :label="'Квота'"
                                    value="projectToView.quota"
                                    readonly>
                                </v-text-field>
                                
                                <v-text-field
                                    :label="'Технологии'"
                                    v-model="projectToView.technologiesNameList"
                                    readonly>
                                </v-text-field>
        
                                <v-text-field
                                    :label="'Направления ВКР'"
                                    v-model="projectToView.workDirectionsNameList"
                                    readonly>
                                </v-text-field>
        
                                <v-text-field
                                    :label="'Группы'"
                                    v-model="projectToView.availableGroupsNameList"
                                    readonly>
                                </v-text-field>
                             <div>
                                <label>Назначены:</label>
                                <div v-for="studentId in projectToView.assignedStudentsIds">
                                    <span >
                                        {{findStudentById(studentId).orderInTutorPrefs || '??'}}.{{findStudentById(studentId).nameAbbreviation}}
                                        {{formatStudentStatus(projectToView,studentId)}}
                                    </span>
                                </div>
                             </div>
                            </v-form>
                        </v-card-text>
                        <v-card-actions class="justify-end">
                            <v-btn
                                text
                                v-on:click="showProjectModal = false">
                                Close
                            </v-btn>
                        </v-card-actions>
                    </v-card>
                </v-dialog>

        </v-app>
    </div>
</div>
</body>
</html>

<script>

 const tableHeaders=[
    {
      value: 'groupName',
      text: 'Группа',
      groupable:true,
      sortable: true,
      align: 'center'
    },     
    {
      value: 'nameAbbreviation',
      text: 'ФИО',
      sortable: true,
      align: 'center'
    },
    {
      value: 'assignedProject',
      text: 'Назначение',
       align: 'center'      
    },
    {
      value: 'preferences',
      text: 'Предпочтения',                
      sortable: false,
      align: 'center'    
    }                                     
];
 
let app = new Vue({
  el: '#app',
  vuetify: new Vuetify(),  
  data (){
      return {
         tableSearch:"",
         students: null,
         projects: null,
         tutors: null,
         headers: [],
         projectToView:null,
         showProjectModal:false,
      }
  },
  mounted(){ 
      this.headers = tableHeaders;
      axios.get(`${params.basePath}/api/monitoring/students`) 
      .then(response => {
          this.students = response.data.studentRecords;
          this.projects = response.data.projectRecords;
          this.tutors = response.data.tutorRecords;
      })
      .catch(function(reason){
          DisplayNotification('Ошибка при загрузке данных','error' );
      });
   
   },
  methods:{
     findTutorById(tutorIdToOpen){
         return this.tutors.find(value => value.tutorId==tutorIdToOpen) ??{};
      },
     findProjectById(projectIdToOpen){
        return this.projects.find(value => value.projectId==projectIdToOpen) ??{};
     },
     findStudentById(studentIdToOpen){
        return this.students.find(value => value.studentId==studentIdToOpen) ??{};
     },    
     viewProject(projectIdToOpen){       
          this.projectToView = this.findProjectById(projectIdToOpen);
          this.showProjectModal=true;
     },
     formatProjectName(projectIdToOpen){     
          let project = this.findProjectById(projectIdToOpen);
          return `${project.projectName}(${this.findTutorById(project.tutorId).nameAbbreviation})`;
     },       
     formatStudentStatus(projectToView, studentId){     
          if (projectToView.assignedStudentsIdsInQuota.includes(studentId))
             return "(В квоте)";
          else 
              return "(В квоту не вошел)";
     },
     formatProjectStatus(student,projectId){    
         let project = this.findProjectById(projectId);
          if (project.assignedStudentsIdsInQuota.includes(student.studentId))
             return "Назначен на проект";
            else if (project.assignedStudentsIds.includes(student.studentId)) 
                return "Отвергнут  на текущей итерации";
          else if (student.assignedProjectId ==null && student.alreadyTryedProjectIds.includes(projectId)) 
              return "Отвергнут преподавателем";
          else 
              return "Не пробовал"
     },       
  }
})
</script>