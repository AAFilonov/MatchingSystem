@using MatchingSystem.UI.Helpers
@using MatchingSystem.UI.Services
@{
  Layout = "~/Views/Shared/_GeneralLayout.cshtml";
  ViewData["title"] = "Users";
  ViewData["active"] = "Users";

  var data = Context.Session.Get<SessionData>("Data");
}

<div id="app">
  <v-app>
    <v-container style="max-width: 1200px">
      <h2 class="col col-12">Мониторинг распределения: Студенты</h2>

      <div class="d-flex align-items-center mb-5">
        <v-text-field
          class="mr-10"
          outlined
          v-model="searchByAbbr"
          label="Поиск по ФИО"
          hide-details>
        </v-text-field>
        
        <v-text-field
          class="mr-10"
          class="input"
          outlined
          v-model="searchByLogin"
          label="Поиск по логину"
          hide-details>
        </v-text-field>
        
        <v-btn v-on:click="filter">Фильтровать</v-btn>
      </div>

      <div>
        <v-data-table
          v-if="users.length"
          :headers="headers"
          :items="users"
          :items-per-page="15"
          class="elevation-1">
          <template v-slot:item="{ item }">
            <tr v-on:click="selectRow(item)" class="text-center cursor-pointer">
              <td>{{ formattingValue(item.userId) }}</td>
              <td>{{ formattingValue(item.login) }}</td>
              <td>{{ formattingValue(item.email) }}</td>
              <td>{{ formattingValue(item.nameAbbreviation) }}</td>
            </tr>
          </template>
        </v-data-table>
      </div>


      <v-row v-else align="center" justify="center" v-else style="min-height: 250px">
        <v-progress-circular
          indeterminate
          size="200"
          color="primary"
          class="">
        </v-progress-circular>
      </v-row>

      <v-dialog persistent width="1000px" v-model="dialogHasOpened">
        <v-card class="dialog-card">
          <v-card-title class="text-h5 lighten-2">
            Редактирование {{ getSelectedUserNameAbbr(selectedUser.userId) }}
          </v-card-title>

          <v-divider></v-divider>

          <v-text-field
            class="input"
            outlined
            v-model="selectedUser.login"
            label="Login"
            hide-details>
          </v-text-field>

          <v-text-field
            class="input"
            outlined
            v-model="selectedUser.email"
            label="E-mail"
            hide-details>
          </v-text-field>

          <v-text-field
            class="input"
            outlined
            v-model="selectedUser.name"
            label="Name"
            hide-details>
          </v-text-field>

          <v-text-field
            class="input"
            outlined
            v-model="selectedUser.surname"
            label="Surname"
            hide-details>
          </v-text-field>

          <v-text-field
            class="input"
            outlined
            v-model="selectedUser.patronimic"
            label="Patronimic"
            hide-details>
          </v-text-field>

          <v-card-actions>
            <v-spacer></v-spacer>
            <v-btn
              color="error"
              v-on:click="dialogHasOpened = false">
              Close
            </v-btn>
            <v-btn
              color="primary"
              v-on:click="saveUsers">
              Save
            </v-btn>
          </v-card-actions>
        </v-card>
      </v-dialog>
    </v-container>
  </v-app>

  <form class="d-none">
    <input type="hidden" ref="matching" value="@data.SelectedMatching?">
  </form>
</div>

<script>
const tableHeaders = [{
  value: 'userId',
  text: 'Id',
  sortable: true,
  align: 'center'
}, {
  value: 'login',
  text: 'Логин',
  sortable: true,
  align: 'center'
}, {
  value: 'email',
  text: 'E-mail',
  align: 'center'      
}, {
  value: 'fullName',
  text: 'ФИО',      
  sortable: true,          
  align: 'center'    
}                                     
];

let app = new Vue({
    el: '#app',
    vuetify: new Vuetify(),
    data() {
        return {
            matchingId: null,
            users: [],
            matchings: [],
            headers: [],
            selectedUser: {},
            dialogHasOpened: false,
            searchByAbbr: '',
            searchByLogin: '',
        }
    },
    methods: {
        async fetchUsers() {
          try {
            return (await axios.get(`${params.basePath}/api/user/getUsers?login=${this.searchByLogin}&abbr=${this.searchByAbbr}`)).data;
          } catch (e) {
            console.error(`Error: ${e}`);
          }
        },
        async fetchMatchings() {
          try {
            return (await axios.get(`${params.basePath}/api/user/getMatchingsList`)).data;
          } catch (e) {
            console.error(`Error: ${e}`);
          }
        },
        formattingValue(value) {
          return value || '—';    
        },
        selectRow(item) {
          this.dialogHasOpened = true;
          this.selectedUser = JSON.parse(JSON.stringify(item));
        },
        async saveUsers() {
            await axios.post(`${params.basePath}/api/user/saveUser`, this.selectedUser);
            
            this.users = await this.fetchUsers();
            this.dialogHasOpened = false;
        },
        getSelectedUserNameAbbr(id) {
            return this.users?.find((user) => user.userId === id)?.nameAbbreviation;
        },
        async filter() {
          this.users = await this.fetchUsers();
        }
    },
    async mounted() {
        this.matchingId = parseInt(this.$refs.matching.value);
        this.headers = [...tableHeaders];
        this.users = await this.fetchUsers();
        this.matchings = await this.fetchMatchings();
    }
})
</script>

<style scoped>
.input + .input {
    margin-top: 20px;
}

.dialog-card {
    padding: 20px;
}
</style>